{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "types": [
      "chrome",
      "node",
      "vite/client"
    ],
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": [
    "extension/src",
    "extension/tests",
    "vite.config.ts"
  ]
}
