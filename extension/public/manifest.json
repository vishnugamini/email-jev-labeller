{
  "manifest_version": 3,
  "name": "Jev Email Labels",
  "version": "0.1.0",
  "description": "Classify visible Gmail conversations using your local Jev service.",
  "permissions": ["storage"],
  "host_permissions": ["http://127.0.0.1/*", "https://mail.google.com/*"],
  "background": {"service_worker": "background.js", "type": "module"},
  "action": {"default_popup": "popup.html"},
  "content_scripts": [{"matches": ["https://mail.google.com/*"], "js": ["content.js"], "css": ["badges.css"]}]
}
